<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      ══════════════════════════════════════════════════════════════════════
       DOCORA — AndroidManifest.xml
       Permission strategy:
         • Scoped storage first (no broad storage permission needed for SAF picks)
         • READ_MEDIA_* for storage scanning on Android 13+
         • MANAGE_EXTERNAL_STORAGE: NOT declared here — available only as opt-in
           in Settings screen with full explanation (Phase 3.1)
         • CAMERA: required for document scanner (Phase 8)
         • INTERNET: NOT declared — app is fully offline; no network calls
      ══════════════════════════════════════════════════════════════════════
    -->

    <!-- Android 11+ (API 30+): All files access for offline document manager -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Android 10 and below: write external storage for file operations -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- Android 12 and below: read external storage for file scanning -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Android 13+: granular media permissions for file scanning -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- Required for document scanner camera feature (Phase 8) -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Required for biometric vault (Phase 3) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <!-- Keep screen on during reading (Phase 4) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Vibration for haptic feedback -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- NOTE: android.permission.INTERNET is intentionally NOT declared.
         Docora is fully offline. No network calls are made. -->

    <application
        android:label="Docora"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="false"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:requestLegacyExternalStorage="false"
        tools:replace="android:requestLegacyExternalStorage">

        <!-- ── Main Activity ─────────────────────────────────────────────── -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.docora.app"
            android:documentLaunchMode="never"
            android:maxRecents="1"
            android:alwaysRetainTaskState="true"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="false" />

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

            <!-- Standard app launch -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- ── Open With: PDF ───────────────────────────────────────── -->
            <intent-filter android:priority="100">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/x-pdf" />
                <data android:mimeType="application/acrobat" />
                <data android:mimeType="applications/vnd.pdf" />
                <data android:mimeType="text/pdf" />
            </intent-filter>

            <!-- ── Open With: Word ─────────────────────────────────────── -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/msword" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/rtf" />
                <data android:mimeType="text/rtf" />
                <data android:mimeType="application/vnd.oasis.opendocument.text" />
            </intent-filter>

            <!-- ── Open With: Excel & Spreadsheet ──────────────────────── -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="application/csv" />
                <data android:mimeType="text/tab-separated-values" />
                <data android:mimeType="application/vnd.oasis.opendocument.spreadsheet" />
            </intent-filter>

            <!-- ── Open With: PowerPoint ───────────────────────────────── -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/vnd.ms-powerpoint" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
                <data android:mimeType="application/vnd.oasis.opendocument.presentation" />
            </intent-filter>

            <!-- ── Open With: Text, Markdown & Code ────────────────────── -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="text/*" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/x-markdown" />
                <data android:mimeType="application/json" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="text/html" />
            </intent-filter>

            <!-- ── Open With: EPUB ─────────────────────────────────────── -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/epub+zip" />
            </intent-filter>

            <!-- ── Open With: Images ───────────────────────────────────── -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="image/*" />
                <data android:mimeType="image/jpeg" />
                <data android:mimeType="image/png" />
                <data android:mimeType="image/webp" />
                <data android:mimeType="image/gif" />
                <data android:mimeType="image/heic" />
            </intent-filter>

            <!-- ── Open With: ZIP archives ─────────────────────────────── -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/x-7z-compressed" />
                <data android:mimeType="application/x-rar-compressed" />
            </intent-filter>

            <!-- ── Open With: Generic MIME with Host & Extension ──────── -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.pdf" />
                <data android:pathPattern=".*\\.PDF" />
                <data android:pathPattern=".*\\.md" />
                <data android:pathPattern=".*\\.MD" />
                <data android:pathPattern=".*\\.txt" />
                <data android:pathPattern=".*\\.TXT" />
                <data android:pathPattern=".*\\.docx" />
                <data android:pathPattern=".*\\.DOCX" />
                <data android:pathPattern=".*\\.doc" />
                <data android:pathPattern=".*\\.DOC" />
                <data android:pathPattern=".*\\.xlsx" />
                <data android:pathPattern=".*\\.XLSX" />
                <data android:pathPattern=".*\\.xls" />
                <data android:pathPattern=".*\\.XLS" />
                <data android:pathPattern=".*\\.csv" />
                <data android:pathPattern=".*\\.CSV" />
                <data android:pathPattern=".*\\.pptx" />
                <data android:pathPattern=".*\\.PPTX" />
                <data android:pathPattern=".*\\.ppt" />
                <data android:pathPattern=".*\\.PPT" />
                <data android:pathPattern=".*\\.epub" />
                <data android:pathPattern=".*\\.EPUB" />
                <data android:pathPattern=".*\\.zip" />
                <data android:pathPattern=".*\\.ZIP" />
            </intent-filter>

            <!-- ── Open With: Files without MIME type ─────────────────── -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.pdf" />
                <data android:pathPattern=".*\\.PDF" />
                <data android:pathPattern=".*\\.md" />
                <data android:pathPattern=".*\\.MD" />
                <data android:pathPattern=".*\\.txt" />
                <data android:pathPattern=".*\\.TXT" />
                <data android:pathPattern=".*\\.docx" />
                <data android:pathPattern=".*\\.DOCX" />
                <data android:pathPattern=".*\\.doc" />
                <data android:pathPattern=".*\\.DOC" />
                <data android:pathPattern=".*\\.xlsx" />
                <data android:pathPattern=".*\\.XLSX" />
                <data android:pathPattern=".*\\.xls" />
                <data android:pathPattern=".*\\.XLS" />
                <data android:pathPattern=".*\\.csv" />
                <data android:pathPattern=".*\\.CSV" />
                <data android:pathPattern=".*\\.pptx" />
                <data android:pathPattern=".*\\.PPTX" />
                <data android:pathPattern=".*\\.ppt" />
                <data android:pathPattern=".*\\.PPT" />
                <data android:pathPattern=".*\\.epub" />
                <data android:pathPattern=".*\\.EPUB" />
                <data android:pathPattern=".*\\.zip" />
                <data android:pathPattern=".*\\.ZIP" />
            </intent-filter>

            <!-- ── ACTION_SEND: Receive shared files ──────────────────── -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>

        </activity>

        <!-- ── FileProvider ──────────────────────────────────────────────── -->
        <!-- Required for sharing files from app's internal/cache directories -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

        <!-- Flutter Embedding V2 metadata -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- ── Desktop AppWidgets ──────────────────────────────────────── -->
        <receiver
            android:name=".DocoraScannerWidget"
            android:label="@string/widget_scanner_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/docora_widget_scanner" />
        </receiver>

        <receiver
            android:name=".DocoraToolsWidget"
            android:label="@string/widget_tools_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/docora_widget_tools" />
        </receiver>

        <receiver
            android:name=".DocoraRecentWidget"
            android:label="@string/widget_recent_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/docora_widget_recent" />
        </receiver>

        <receiver
            android:name=".DocoraVaultWidget"
            android:label="@string/widget_vault_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/docora_widget_vault" />
        </receiver>

        <receiver
            android:name=".DocoraReadingTrackerWidget"
            android:label="@string/widget_tracker_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/docora_widget_tracker" />
        </receiver>

        <receiver
            android:name=".DocoraAudioReaderWidget"
            android:label="@string/widget_audio_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/docora_widget_audio" />
        </receiver>

    </application>

    <!-- Camera feature declaration (not required but improves Play Store filtering) -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.fingerprint"
        android:required="false" />

</manifest>
