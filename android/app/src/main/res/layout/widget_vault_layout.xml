<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_vault_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_card"
    android:padding="@dimen/widget_space_16"
    android:orientation="vertical">

    <!-- Top: 40dp Dynamic Accent-Container Circle with Lock Icon -->
    <ImageView
        android:id="@+id/widget_action_vault"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="Vault" />

    <!-- Spacer to push content to bottom -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Private Vault"
            style="@style/WidgetTitle" />

        <TextView
            android:id="@+id/widget_vault_count_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Confidential Storage"
            style="@style/WidgetCaption" />

        <!-- 6dp Dynamic Accent Progress Bar Image -->
        <ImageView
            android:id="@+id/widget_vault_progress_image"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="@dimen/widget_space_8"
            android:scaleType="fitXY"
            android:contentDescription="Storage Usage" />

        <TextView
            android:id="@+id/widget_vault_storage_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/widget_space_4"
            android:text="Tap to lock &amp; view files"
            style="@style/WidgetCaption" />
    </LinearLayout>

</LinearLayout>
