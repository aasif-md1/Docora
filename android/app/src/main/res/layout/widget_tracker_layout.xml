<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_tracker_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_card"
    android:paddingStart="@dimen/widget_space_12"
    android:paddingEnd="@dimen/widget_space_12"
    android:paddingTop="@dimen/widget_space_8"
    android:paddingBottom="@dimen/widget_space_8"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- PDF -->
    <LinearLayout
        android:id="@+id/widget_tracker_pdf"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="@dimen/widget_icon_box_size"
            android:layout_height="@dimen/widget_icon_box_size"
            android:background="@drawable/widget_surface_variant_box">

            <ImageView
                android:id="@+id/tracker_icon_pdf"
                android:layout_width="@dimen/widget_icon_size"
                android:layout_height="@dimen/widget_icon_size"
                android:layout_gravity="center"
                android:src="@drawable/ic_format_pdf"
                android:contentDescription="PDF" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/widget_space_4"
            android:text="PDF"
            style="@style/WidgetIconLabel" />
    </LinearLayout>

    <!-- Word -->
    <LinearLayout
        android:id="@+id/widget_tracker_word"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="@dimen/widget_icon_box_size"
            android:layout_height="@dimen/widget_icon_box_size"
            android:background="@drawable/widget_surface_variant_box">

            <ImageView
                android:id="@+id/tracker_icon_word"
                android:layout_width="@dimen/widget_icon_size"
                android:layout_height="@dimen/widget_icon_size"
                android:layout_gravity="center"
                android:src="@drawable/ic_format_word"
                android:contentDescription="Word" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/widget_space_4"
            android:text="Word"
            style="@style/WidgetIconLabel" />
    </LinearLayout>

    <!-- PPT -->
    <LinearLayout
        android:id="@+id/widget_tracker_ppt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="@dimen/widget_icon_box_size"
            android:layout_height="@dimen/widget_icon_box_size"
            android:background="@drawable/widget_surface_variant_box">

            <ImageView
                android:id="@+id/tracker_icon_ppt"
                android:layout_width="@dimen/widget_icon_size"
                android:layout_height="@dimen/widget_icon_size"
                android:layout_gravity="center"
                android:src="@drawable/ic_format_ppt"
                android:contentDescription="PPT" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/widget_space_4"
            android:text="PPT"
            style="@style/WidgetIconLabel" />
    </LinearLayout>

    <!-- Excel -->
    <LinearLayout
        android:id="@+id/widget_tracker_excel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="@dimen/widget_icon_box_size"
            android:layout_height="@dimen/widget_icon_box_size"
            android:background="@drawable/widget_surface_variant_box">

            <ImageView
                android:id="@+id/tracker_icon_excel"
                android:layout_width="@dimen/widget_icon_size"
                android:layout_height="@dimen/widget_icon_size"
                android:layout_gravity="center"
                android:src="@drawable/ic_format_excel"
                android:contentDescription="Excel" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/widget_space_4"
            android:text="Excel"
            style="@style/WidgetIconLabel" />
    </LinearLayout>

</LinearLayout>
