<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_tools_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_card"
    android:paddingStart="@dimen/widget_space_12"
    android:paddingEnd="@dimen/widget_space_12"
    android:paddingTop="@dimen/widget_space_8"
    android:paddingBottom="@dimen/widget_space_8"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- Tool 1: Image to PDF -->
    <LinearLayout
        android:id="@+id/tool_action_img_pdf"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="@dimen/widget_icon_box_size"
            android:layout_height="@dimen/widget_icon_box_size"
            android:background="@drawable/widget_surface_variant_box">

            <ImageView
                android:id="@+id/tool_icon_img_pdf"
                android:layout_width="@dimen/widget_icon_size"
                android:layout_height="@dimen/widget_icon_size"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_img_pdf"
                android:contentDescription="Image to PDF" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/widget_space_4"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="Img to PDF"
            style="@style/WidgetIconLabel" />
    </LinearLayout>

    <!-- Tool 2: Merge -->
    <LinearLayout
        android:id="@+id/tool_action_merge"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="@dimen/widget_icon_box_size"
            android:layout_height="@dimen/widget_icon_box_size"
            android:background="@drawable/widget_surface_variant_box">

            <ImageView
                android:id="@+id/tool_icon_merge"
                android:layout_width="@dimen/widget_icon_size"
                android:layout_height="@dimen/widget_icon_size"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_merge"
                android:contentDescription="Merge" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/widget_space_4"
            android:gravity="center"
            android:maxLines="1"
            android:text="Merge"
            style="@style/WidgetIconLabel" />
    </LinearLayout>

    <!-- Tool 3: Watermark -->
    <LinearLayout
        android:id="@+id/tool_action_watermark"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="@dimen/widget_icon_box_size"
            android:layout_height="@dimen/widget_icon_box_size"
            android:background="@drawable/widget_surface_variant_box">

            <ImageView
                android:id="@+id/tool_icon_watermark"
                android:layout_width="@dimen/widget_icon_size"
                android:layout_height="@dimen/widget_icon_size"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_watermark"
                android:contentDescription="Watermark" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/widget_space_4"
            android:gravity="center"
            android:maxLines="1"
            android:text="Watermark"
            style="@style/WidgetIconLabel" />
    </LinearLayout>

    <!-- Tool 4: Compress -->
    <LinearLayout
        android:id="@+id/tool_action_compress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="@dimen/widget_icon_box_size"
            android:layout_height="@dimen/widget_icon_box_size"
            android:background="@drawable/widget_surface_variant_box">

            <ImageView
                android:id="@+id/tool_icon_compress"
                android:layout_width="@dimen/widget_icon_size"
                android:layout_height="@dimen/widget_icon_size"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_compress"
                android:contentDescription="Compress" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/widget_space_4"
            android:gravity="center"
            android:maxLines="1"
            android:text="Compress"
            style="@style/WidgetIconLabel" />
    </LinearLayout>

</LinearLayout>
