<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_scanner_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/widget_space_16"
    android:paddingEnd="@dimen/widget_space_16"
    android:paddingTop="@dimen/widget_space_12"
    android:paddingBottom="@dimen/widget_space_12">

    <!-- Left: 44dp Surface-Variant Box with Accent Camera Icon -->
    <FrameLayout
        android:layout_width="@dimen/widget_icon_box_size"
        android:layout_height="@dimen/widget_icon_box_size"
        android:background="@drawable/widget_surface_variant_box">

        <ImageView
            android:id="@+id/widget_scanner_left_icon"
            android:layout_width="@dimen/widget_icon_size"
            android:layout_height="@dimen/widget_icon_size"
            android:layout_gravity="center"
            android:src="@drawable/ic_widget_camera"
            android:contentDescription="Scanner" />
    </FrameLayout>

    <!-- Center: Title and Caption -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/widget_space_12"
        android:layout_marginEnd="@dimen/widget_space_12"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scan document"
            style="@style/WidgetTitle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Scan and extract text"
            style="@style/WidgetCaption" />
    </LinearLayout>

    <!-- Right: 44dp Dynamic Accent Circle Action Button -->
    <ImageView
        android:id="@+id/widget_action_scan"
        android:layout_width="@dimen/widget_icon_box_size"
        android:layout_height="@dimen/widget_icon_box_size"
        android:contentDescription="Scan" />

</LinearLayout>
