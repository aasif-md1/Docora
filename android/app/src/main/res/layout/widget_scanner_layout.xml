<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_scanner_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_scanner"
    android:padding="14dp">

    <!-- Right Side: Glowing Holographic 3D Document Fan Graphic -->
    <ImageView
        android:id="@+id/scanner_fan_graphic"
        android:layout_width="85dp"
        android:layout_height="85dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:src="@drawable/ic_widget_doc_fan"
        android:contentDescription="Holographic Fan" />

    <!-- Left Side Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toStartOf="@id/scanner_fan_graphic"
        android:layout_marginEnd="6dp"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- Viewfinder Icon + Titles -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_icon_squircle_emerald"
                android:gravity="center">

                <ImageView
                    android:id="@+id/widget_app_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_widget_viewfinder"
                    android:contentDescription="Scanner" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Docora Scanner"
                    android:textColor="#FFFFFF"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="1-Tap Scan &amp; OCR"
                    android:textColor="#94A3B8"
                    android:textSize="10.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Luminous Mint Green Action Button -->
        <TextView
            android:id="@+id/widget_action_scan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/widget_btn_mint_pill"
            android:paddingHorizontal="18dp"
            android:paddingVertical="7.5dp"
            android:text="Scan Now >"
            android:textColor="#04271F"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</RelativeLayout>
