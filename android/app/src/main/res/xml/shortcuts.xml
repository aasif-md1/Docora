            android:action="android.intent.action.VIEW"
            android:targetPackage="com.docora.app"
            android:targetClass="com.docora.app.MainActivity">
            <extra android:name="route" android:value="/files" />
        </intent>
    </shortcut>

    <shortcut
        android:shortcutId="shortcut_vault"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_vault"
        android:shortcutShortLabel="@string/shortcut_vault"
