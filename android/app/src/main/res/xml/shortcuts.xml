            <extra android:name="route" android:value="/tools" />
        </intent>
    </shortcut>

    <shortcut
        android:shortcutId="shortcut_open"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_open"
        android:shortcutShortLabel="@string/shortcut_open"
